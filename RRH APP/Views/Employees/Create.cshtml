@model RRH_APP.Models.Employee
@{
    ViewData["Title"] = "Registrar Empleado";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-person-plus text-primary me-2"></i>Registrar Nuevo Empleado</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Document" class="form-label fw-semibold">Número de Documento <span class="text-danger">*</span></label>
                            <input asp-for="Document" class="form-control" placeholder="Ej. 1098765432" maxlength="15" required />
                            <span asp-validation-for="Document" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label fw-semibold">Departamento / Área <span class="text-danger">*</span></label>
                            <select asp-for="DepartmentId" class="form-select" asp-items="@ViewBag.DepartmentId" required>
                                <option value="">-- Seleccione un Departamento --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold">Nombres <span class="text-danger">*</span></label>
                            <input asp-for="FirstName" class="form-control" placeholder="Ej. Carlos Eduardo" maxlength="60" required />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold">Apellidos <span class="text-danger">*</span></label>
                            <input asp-for="LastName" class="form-control" placeholder="Ej. Gómez Pérez" maxlength="60" required />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="ejemplo@correo.com" maxlength="120" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">Teléfono</label>
                            <input asp-for="Phone" class="form-control" placeholder="Ej. 3101234567" maxlength="20" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Position" class="form-label fw-semibold">Cargo / Puesto <span class="text-danger">*</span></label>
                            <input asp-for="Position" class="form-control" placeholder="Ej. Desarrollador Senior" maxlength="80" required />
                            <span asp-validation-for="Position" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Salary" class="form-label fw-semibold">Salario Mensual <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Salary" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="Salary" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="HireDate" class="form-label fw-semibold">Fecha de Contratación <span class="text-danger">*</span></label>
                            <input asp-for="HireDate" type="date" class="form-control" required />
                            <span asp-validation-for="HireDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="switchEmpActive" checked>
                                <label class="form-check-label fw-semibold" for="switchEmpActive">Empleado en estado Activo</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i> Registrar Empleado</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
