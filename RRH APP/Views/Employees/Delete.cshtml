@model RRH_APP.Models.Employee
@{
    ViewData["Title"] = "Eliminar Empleado";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 border-top border-danger border-4">
            <div class="card-header bg-white py-3">
                <h4 class="fw-bold mb-0 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>¿Eliminar Empleado?</h4>
            </div>
            <div class="card-body p-4">
                <p class="text-muted">¿Estás seguro de que deseas retirar y eliminar permanentemente este registro de empleado?</p>

                <div class="bg-light p-3 rounded mb-4">
                    <div class="row mb-2">
                        <div class="col-4 fw-semibold text-muted">Empleado:</div>
                        <div class="col-8 fw-bold">@Model.FirstName @Model.LastName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 fw-semibold text-muted">Documento:</div>
                        <div class="col-8 font-monospace">@Model.Document</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 fw-semibold text-muted">Cargo:</div>
                        <div class="col-8">@Model.Position</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 fw-semibold text-muted">Departamento:</div>
                        <div class="col-8">@Model.Department?.Name</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 fw-semibold text-muted">Salario:</div>
                        <div class="col-8 font-monospace fw-bold text-success">@Model.Salary.ToString("C2")</div>
                    </div>
                    <div class="row">
                        <div class="col-4 fw-semibold text-muted">Estado:</div>
                        <div class="col-8">
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                                @(Model.IsActive ? "Activo" : "Inactivo")
                            </span>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash-fill me-1"></i> Confirmar Eliminación</button>
                </form>
            </div>
        </div>
    </div>
</div>
