@model IEnumerable<RRH_APP.Models.Employee>
@{
    ViewData["Title"] = "Directorio de Empleados";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-badge text-primary me-2"></i>Directorio de Empleados</h2>
        <p class="text-muted mb-0">Gestión de nómina, contratos y datos personales de colaboradores</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Nuevo Empleado
    </a>
</div>

<!-- Filtros y Búsqueda -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Buscar por documento, nombre, cargo o email...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="departmentId" class="form-select" asp-items="@ViewBag.Departments">
                    <option value="">-- Todos los Departamentos --</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="isActive" class="form-select">
                    <option value="">-- Estado --</option>
                    <!option value="true" @(ViewBag.IsActive == true ? "selected" : "")>Activos</!option>
                    <!option value="false" @(ViewBag.IsActive == false ? "selected" : "")>Inactivos</!option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100"><i class="bi bi-funnel"></i> Filtrar</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search) || ViewBag.DepartmentId != null || ViewBag.IsActive != null)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Empleados -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Empleado</th>
                        <th>Documento</th>
                        <th>Departamento</th>
                        <th>Cargo</th>
                        <th class="text-end">Salario</th>
                        <th>Fecha Ingreso</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-person-x fs-3 d-block mb-2"></i>
                                No se encontraron empleados con los criterios de búsqueda.
                            </td>
                        </tr>
                    }
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 38px; height: 38px; font-weight: bold; font-size: 0.85rem;">
                                        @emp.FirstName.Substring(0, 1)@emp.LastName.Substring(0, 1)
                                    </div>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@emp.Id" class="fw-semibold text-decoration-none text-dark">
                                            @emp.FirstName @emp.LastName
                                        </a>
                                        <div class="small text-muted">@emp.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="font-monospace small bg-light p-1 rounded border">@emp.Document</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border">
                                    @emp.Department?.Name
                                </span>
                            </td>
                            <td>@emp.Position</td>
                            <td class="text-end font-monospace fw-bold">
                                @emp.Salary.ToString("C2")
                            </td>
                            <td>
                                <small class="text-muted">@emp.HireDate.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td class="text-center">
                                <span class="badge @(emp.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")">
                                    @(emp.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@emp.Id" class="btn btn-outline-secondary" title="Ver Perfil">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
