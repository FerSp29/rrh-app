@model IEnumerable<RRH_APP.Models.Department>
@{
    ViewData["Title"] = "Departamentos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-diagram-3 text-primary me-2"></i>Departamentos</h2>
        <p class="text-muted mb-0">Gestión de áreas y departamentos de la empresa</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Departamento
    </a>
</div>

<!-- Barra de búsqueda -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Buscar por código, nombre o ubicación...">
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100"><i class="bi bi-funnel"></i> Filtrar</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Departamentos -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Ubicación</th>
                        <th>Presupuesto</th>
                        <th>Contacto</th>
                        <th class="text-center">Empleados</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No se encontraron departamentos registrados.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-secondary font-monospace">@item.Code</span>
                            </td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                    @item.Name
                                </a>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 250px;">@item.Description</div>
                                }
                            </td>
                            <td>
                                <small class="text-muted"><i class="bi bi-geo-alt"></i> @(item.Location ?? "N/A")</small>
                            </td>
                            <td class="font-monospace">
                                @(item.Budget.HasValue ? item.Budget.Value.ToString("C2") : "-")
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Phone))
                                {
                                    <div><small><i class="bi bi-telephone text-muted"></i> @item.Phone</small></div>
                                }
                                @if (!string.IsNullOrEmpty(item.Email))
                                {
                                    <div><small><i class="bi bi-envelope text-muted"></i> @item.Email</small></div>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill bg-primary">@item.Employees.Count</span>
                            </td>
                            <td class="text-center">
                                <span class="badge @(item.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")">
                                    @(item.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
