@model RRH_APP.Models.Department
@{
    ViewData["Title"] = "Detalle del Departamento";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left"></i> Volver al listado
    </a>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1">@Model.Name</h2>
            <span class="badge bg-secondary font-monospace fs-6">@Model.Code</span>
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger") ms-2">
                @(Model.IsActive ? "Activo" : "Inactivo")
            </span>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i> Editar
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i> Eliminar
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Información General -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-info-circle text-primary me-2"></i> Información General
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">@(Model.Description ?? "Sin descripción registrada.")</p>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Ubicación:</span>
                        <span class="fw-semibold">@(Model.Location ?? "No asignada")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Presupuesto Asignado:</span>
                        <span class="fw-semibold font-monospace">@(Model.Budget.HasValue ? Model.Budget.Value.ToString("C2") : "No definido")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Teléfono de contacto:</span>
                        <span>@(Model.Phone ?? "N/A")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Correo electrónico:</span>
                        <span>@(Model.Email ?? "N/A")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Fecha de creación:</span>
                        <span>@Model.CreatedAt.ToString("g")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Personal Asignado -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-people text-primary me-2"></i> Empleados del Departamento (@Model.Employees.Count)</span>
                <a asp-controller="Employees" asp-action="Create" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg"></i> Asignar Empleado
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Documento</th>
                                <th>Nombre Completo</th>
                                <th>Cargo</th>
                                <th>Salario</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Employees.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        No hay empleados asignados a este departamento actualmente.
                                    </td>
                                </tr>
                            }
                            @foreach (var emp in Model.Employees)
                            {
                                <tr>
                                    <td class="font-monospace small">@emp.Document</td>
                                    <td class="fw-semibold">
                                        <a asp-controller="Employees" asp-action="Details" asp-route-id="@emp.Id" class="text-decoration-none text-dark">
                                            @emp.FirstName @emp.LastName
                                        </a>
                                    </td>
                                    <td>@emp.Position</td>
                                    <td class="font-monospace">@emp.Salary.ToString("C2")</td>
                                    <td class="text-center">
                                        <span class="badge @(emp.IsActive ? "bg-success" : "bg-danger")">
                                            @(emp.IsActive ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Employees" asp-action="Details" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
