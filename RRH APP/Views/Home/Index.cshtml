@model RRH_APP.Models.DashboardViewModel
@{
    ViewData["Title"] = "Panel Principal";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Panel de Control de Recursos Humanos
        </h2>
        <p class="text-muted mb-0">Resumen general de departamentos, empleados y distribución salarial en tiempo real.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-controller="Employees" asp-action="Create" class="btn btn-primary me-2 shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Nuevo Empleado
        </a>
        <a asp-controller="Departments" asp-action="Create" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-folder-plus me-1"></i> Nuevo Depto
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-primary border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Departamentos</div>
                        <h3 class="fw-bold text-dark mb-0">@Model.TotalDepartments</h3>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                </div>
                <div class="mt-3 small">
                    <a asp-controller="Departments" asp-action="Index" class="text-decoration-none">
                        Ver todos los departamentos <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-success border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Total Empleados</div>
                        <h3 class="fw-bold text-dark mb-0">@Model.TotalEmployees</h3>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle fs-3">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <div class="mt-3 small">
                    <a asp-controller="Employees" asp-action="Index" class="text-decoration-none">
                        Directorio de empleados <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-warning border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Nómina Total</div>
                        <h3 class="fw-bold text-dark mb-0">@Model.TotalPayroll.ToString("C2")</h3>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle fs-3">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">
                    Suma total de salarios brutos
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-info border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Salario Promedio</div>
                        <h3 class="fw-bold text-dark mb-0">@Model.AverageSalary.ToString("C2")</h3>
                    </div>
                    <div class="bg-info-subtle text-info p-3 rounded-circle fs-3">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">
                    Promedio general del personal
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Tabla Resumen de Departamentos -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
            <div class="card-header bg-transparent border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-buildings text-primary me-2"></i>Departamentos y Plantilla
                </h5>
                <a asp-controller="Departments" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    Gestionar
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Ubicación</th>
                                <th class="text-center">Personal</th>
                                <th class="text-end">Nómina Depto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model.DepartmentSummaries)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary font-monospace">@dept.Code</span>
                                    </td>
                                    <td>
                                        <a asp-controller="Departments" asp-action="Details" asp-route-id="@dept.Id" class="fw-semibold text-decoration-none text-dark">
                                            @dept.Name
                                        </a>
                                    </td>
                                    <td>
                                        <small class="text-muted"><i class="bi bi-geo-alt"></i> @(dept.Location ?? "N/A")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-primary">@dept.EmployeeCount</span>
                                    </td>
                                    <td class="text-end font-monospace fw-semibold">
                                        @dept.DepartmentPayroll.ToString("C2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Empleados Recientes -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
            <div class="card-header bg-transparent border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history text-primary me-2"></i>Últimas Incorporaciones
                </h5>
                <a asp-controller="Employees" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    Ver todos
                </a>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var emp in Model.RecentEmployees)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px; font-weight: bold;">
                                    @emp.FirstName.Substring(0, 1)@emp.LastName.Substring(0, 1)
                                </div>
                                <div>
                                    <a asp-controller="Employees" asp-action="Details" asp-route-id="@emp.Id" class="fw-bold text-decoration-none text-dark d-block">
                                        @emp.FirstName @emp.LastName
                                    </a>
                                    <div class="small text-muted">@emp.Position &bull; @emp.Department?.Name</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge @(emp.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")">
                                    @(emp.IsActive ? "Activo" : "Inactivo")
                                </span>
                                <div class="small text-muted mt-1">@emp.HireDate.ToString("dd/MM/yyyy")</div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>